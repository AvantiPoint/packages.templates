{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowPackageOverwrites": true,
  "PackageDeletionBehavior": "Unlist",
  /*
  The following JWT and OAuth settings need to be configured
  before the project can be successfully executed.
  */
  "JwtSettings": {
    "Secret": "ReplaceWithASecureRandomKeyAtLeast32CharactersLong",
    "Issuer": "NuGetFeedTemplate",
    "Audience": "NuGetFeedTemplate",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "OAuth": {
    "Provider": "Microsoft",
    "Microsoft": {
      "TenantId": "ReplaceTenantId",
      "ClientId": "ReplaceClientId",
      "ClientSecret": "ReplaceClientSecret",
      "Instance": "https://login.microsoftonline.com/",
      "CallbackPath": "/api/authentication/callback/microsoft"
    },
    "Google": {
      "ClientId": "ReplaceGoogleClientId",
      "ClientSecret": "ReplaceGoogleClientSecret",
      "CallbackPath": "/api/authentication/callback/google"
    }
  },
  "Database": {
    "Type": "SqlServer"
  },
  "EmailSettings": {
    "FromAddress": "no-reply@ReplaceDomain",
    "FromName": "NuGetFeedTemplate",
    "SendGridKey": "ReplaceSendGridApiKey",
    "PostmarkKey": "ReplacePostmarkApiKey",
    "TemplatesDirectory": "email-templates"
  },
  "FeedSettings": {
    "ServerName": "NuGetFeedTemplate"
  },
  "Shield": {
    "ServerName": "NuGetFeedTemplate"
  },
  "Search": {
    "Type": "Database"
  },
  "Storage": {
    "Type": "FileSystem",
    "Path": "App_Data"
    //   "Type": "AzureBlobStorage",
    //   "AccountName": "{your account name}",
    //   "AccessKey": "{your account key}",
    //   "Container": "NuGetFeedTemplate"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=NuGetFeedTemplate;Trusted_Connection=True;MultipleActiveResultSets=true"
  }
}
