@page
@model IndexModel
@{
  ViewData["Title"] = User.Identity.IsAuthenticated ? "Packages" : "Home page";
}

@if (User.Identity.IsAuthenticated)
{
  <div class="row mb-3">
    <form aria-label="Package search and filter" class="col-sm-12" method="get" id="searchForm">
      <div class="input-group mb-3">
        <input name="q" type="text" class="form-control" id="search" aria-label="Enter packages to search" placeholder="Search for packages..." value="@Model.Search.Query">
        <span class="input-group-btn">
          <button class="btn btn-default btn-warning btn-search" type="submit" title="Search for packages" aria-label="Search">
            <span class="ms-Icon ms-Icon--Search" aria-hidden="true"></span>
          </button>
        </span>
      </div>

      <!-- Filter Controls -->
      <div class="row mb-3">
        <div class="col-md-3 col-sm-6 mb-2">
          <label for="framework" class="form-label">Framework</label>
          <select name="framework" id="framework" class="form-control" onchange="document.getElementById('searchForm').submit()">
            <option value="">All Frameworks</option>
            <option value="net10.0" selected="@(Model.SelectedFramework == "net10.0" ? "selected" : null)">.NET 10.0</option>
            <option value="net9.0" selected="@(Model.SelectedFramework == "net9.0" ? "selected" : null)">.NET 9.0</option>
            <option value="net8.0" selected="@(Model.SelectedFramework == "net8.0" ? "selected" : null)">.NET 8.0</option>
            <option value="net7.0" selected="@(Model.SelectedFramework == "net7.0" ? "selected" : null)">.NET 7.0</option>
            <option value="net6.0" selected="@(Model.SelectedFramework == "net6.0" ? "selected" : null)">.NET 6.0</option>
            <option value="netstandard2.1" selected="@(Model.SelectedFramework == "netstandard2.1" ? "selected" : null)">.NET Standard 2.1</option>
            <option value="netstandard2.0" selected="@(Model.SelectedFramework == "netstandard2.0" ? "selected" : null)">.NET Standard 2.0</option>
          </select>
        </div>

        <div class="col-md-3 col-sm-6 mb-2">
          <label for="runtime" class="form-label">Runtime</label>
          <select name="runtime" id="runtime" class="form-control" onchange="document.getElementById('searchForm').submit()">
            <option value="">All Runtimes</option>
            <option value="android" selected="@(Model.SelectedRuntime == "android" ? "selected" : null)">Android</option>
            <option value="ios" selected="@(Model.SelectedRuntime == "ios" ? "selected" : null)">iOS</option>
            <option value="maccatalyst" selected="@(Model.SelectedRuntime == "maccatalyst" ? "selected" : null)">Mac Catalyst</option>
            <option value="macos" selected="@(Model.SelectedRuntime == "macos" ? "selected" : null)">macOS</option>
            <option value="tvos" selected="@(Model.SelectedRuntime == "tvos" ? "selected" : null)">tvOS</option>
            <option value="windows" selected="@(Model.SelectedRuntime == "windows" ? "selected" : null)">Windows</option>
            <option value="tizen" selected="@(Model.SelectedRuntime == "tizen" ? "selected" : null)">Tizen</option>
            <option value="desktop" selected="@(Model.SelectedRuntime == "desktop" ? "selected" : null)">Desktop (Uno Platform)</option>
            <option value="browserwasm" selected="@(Model.SelectedRuntime == "browserwasm" ? "selected" : null)">Browser WebAssembly (Uno Platform)</option>
          </select>
          <small class="form-text text-muted">Platform-specific packages only</small>
        </div>

        <div class="col-md-3 col-sm-6 mb-2">
          <label for="packageType" class="form-label">Package Type</label>
          <select name="packageType" id="packageType" class="form-control" onchange="document.getElementById('searchForm').submit()">
            <option value="">All Types</option>
            <option value="Dependency" selected="@(Model.SelectedPackageType == "Dependency" ? "selected" : null)">Dependency</option>
            <option value="Template" selected="@(Model.SelectedPackageType == "Template" ? "selected" : null)">Template</option>
            <option value="DotnetTool" selected="@(Model.SelectedPackageType == "DotnetTool" ? "selected" : null)">.NET Tool</option>
            <option value="MCPServer" selected="@(Model.SelectedPackageType == "MCPServer" ? "selected" : null)">MCP Server</option>
            <option value="SDK" selected="@(Model.SelectedPackageType == "SDK" ? "selected" : null)">SDK</option>
          </select>
        </div>

        <div class="col-md-3 col-sm-6 mb-2">
          <label for="prereleaseCheckbox" class="form-label">Include Prerelease</label>
          <div class="form-check mt-2">
            <input type="hidden" name="prerelease" value="false" />
            <input type="checkbox" name="prerelease" id="prereleaseCheckbox" class="form-check-input" value="true" @(Model.Search.IncludePrerelease ? "checked" : "") onchange="document.getElementById('searchForm').submit()">
            <label class="form-check-label" for="prereleaseCheckbox">
              Include pre-release packages
            </label>
          </div>
        </div>
      </div>
    </form>
  </div>
  <section role="main">
    @if(Model.SearchResponse.TotalHits == 1)
    {
      <h1 role="alert">
        There is @Model.SearchResponse.TotalHits.ToString("#,##0") package
      </h1>
    }
    else
    {
      <h1 role="alert">
        There are @Model.SearchResponse.TotalHits.ToString("#,##0") packages
      </h1>
    }
    <div class="row mb-3">
      <div class="col-sm-12">
        @if(!string.IsNullOrEmpty(Model.SelectedFramework) || !string.IsNullOrEmpty(Model.SelectedRuntime) || !string.IsNullOrEmpty(Model.SelectedPackageType) || !string.IsNullOrEmpty(Model.Search.Query))
        {
          <div class="active-filters">
            <strong>Active Filters:</strong>
            @if(!string.IsNullOrEmpty(Model.Search.Query))
            {
              <span class="badge bg-primary">Query: @Model.Search.Query</span>
            }
            @if(!string.IsNullOrEmpty(Model.SelectedFramework))
            {
              <span class="badge bg-info">Framework: @Model.SelectedFramework</span>
            }
            @if(!string.IsNullOrEmpty(Model.SelectedRuntime))
            {
              <span class="badge bg-info">Runtime: @Model.SelectedRuntime</span>
            }
            @if(!string.IsNullOrEmpty(Model.SelectedPackageType))
            {
              <span class="badge bg-info">Type: @Model.SelectedPackageType</span>
            }
            @if(!Model.Search.IncludePrerelease)
            {
              <span class="badge bg-secondary">Stable Only</span>
            }
            <a href="/" class="btn btn-sm btn-outline-secondary ms-2">Clear All Filters</a>
          </div>
        }
      </div>
    </div>
    <div class="list-packages" role="list">
      @foreach(var package in Model.SearchResponse.Data)
      {
        <article class="package" role="listitem">
          <div class="row">
            <div class="col-sm-1 hidden-xs hidden-sm col-package-icon">
              <img class="package-icon img-responsive" aria-hidden="true" alt="" src="@package.IconUrl" onerror="this.src='/img/default-package-icon.svg'; this.onerror = null;">
            </div>
            <div class="col-sm-11">
              <div class="package-header">
                <a class="package-title" href="packages/@package.PackageId" data-track="search-selection" data-track-value="0" data-package-id="@package.PackageId" data-package-version="@package.Version" data-use-version="False">@package.PackageId</a>
                <span class="package-by">
                  by:
                  @foreach(var owner in package.Authors)
                  {
                    <a href="#" title="@owner">@owner</a>
                  }
                </span>
              </div>

              <ul class="package-list">
                <li>
                  <span class="icon-text">
                      <i class="ms-Icon ms-Icon--Download" aria-hidden="true"></i>
                      @package.TotalDownloads.ToString("#,##0") total downloads
                  </span>
                </li>
                <li>
                  <span class="icon-text">
                    <i class="ms-Icon ms-Icon--History" aria-hidden="true"></i>
                      last updated <span data-datetime="@package.Published.ToString("F")" title="@package.Published.ToString("F")">@package.Published.Humanize()</span>
                  </span>
                </li>
                <li>
                  <span class="icon-text">
                    <i class="ms-Icon ms-Icon--Flag" aria-hidden="true"></i>
                    Latest version: <span class="text-nowrap">@package.Version </span>
                  </span>
                </li>
                <li class="package-tags">
                  <span class="icon-text">
                    <i class="ms-Icon ms-Icon--Tag" aria-hidden="true"></i>
                    @foreach(var tag in @package.Tags)
                    {
                      <a href="/@Model.BuildQueryString(query: $"Tags:\"{tag}\"")" title="Search for @tag">@tag</a>
                    }
                  </span>
                </li>
              </ul>

              <div class="package-details">
                @package.Description
              </div>
            </div>
          </div>
        </article>
      }
    </div>
    <div class="row">
      <div class="col-xs-12 clearfix">
        <ul class="pager">
          @if(Model.CurrentPage - 1 >= 0)
          {
            <li class="previous">
              <a href="/@Model.BuildQueryString(page: Model.CurrentPage - 1)" title="Go to the previous page.">Previous</a>
            </li>
          }
          else
          {
            <li class="previous">
              Previous
            </li>
          }
          @if(Model.HasNext)
          {
            <li class="next">
              <a href="/@Model.BuildQueryString(page: Model.CurrentPage + 1)" title="Go to the next page.">Next</a>
            </li>
          }
          else
          {
            <li class="next">
              Next
            </li>
          }
        </ul>
      </div>
    </div>
  </section>
}
else
{
  <div class="row">
    <div class="col-12">
      <h1 class=""display-4 text-center">Please login</h1>
    </div>
  </div>
}
